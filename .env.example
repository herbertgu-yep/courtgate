# ===== 数据库 / Redis（跨机部署时把 localhost 换成对应主机或容器服务名） =====
COURTGATE_DATABASE_URL=mysql+aiomysql://courtgate:courtgate@localhost:3306/courtgate?charset=utf8mb4
COURTGATE_SYNC_DATABASE_URL=mysql+pymysql://courtgate:courtgate@localhost:3306/courtgate?charset=utf8mb4
COURTGATE_REDIS_URL=redis://localhost:6379/0

# ===== 密钥：生产环境必须改成随机长字符串（openssl rand -hex 32） =====
COURTGATE_JWT_SECRET=change-me-to-a-random-32byte-string
COURTGATE_PAYMENT_SECRET=change-me-to-a-random-32byte-string

# ===== 业务参数（可选，默认值见 app/core/config.py） =====
# 预约后支付时限（秒），超时自动取消
# COURTGATE_BOOKING_EXPIRE_SECONDS=900
# 单笔预约最多时段数
# COURTGATE_MAX_SLOTS_PER_BOOKING=4
# 积分抵扣上限（占应付的比例，基点，5000 = 50%）
# COURTGATE_POINTS_REDEEM_MAX_BP=5000
# 预约接口限流开关
# COURTGATE_RATE_LIMIT_ENABLED=true

# ===== 邮件通知渠道（选填；不填则只有站内信） =====
# COURTGATE_SMTP_HOST=
# COURTGATE_SMTP_PORT=587
# COURTGATE_SMTP_USER=
# COURTGATE_SMTP_PASSWORD=
# COURTGATE_SMTP_FROM=

# ===== 其它 =====
# 是否托管 H5 前端（反向代理托管静态资源时可关）
# COURTGATE_UI_ENABLED=true
# 日志级别
# COURTGATE_LOG_LEVEL=INFO
